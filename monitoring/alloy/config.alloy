// awl does not turn on mutex and block profiling, so those profiles are left
// out. The profiles are taken once a minute: the heap profile costs awl the
// most CPU to take. instance is the same as in prometheus.yml: awl Profiles
// finds the profiles of a node by it.

pyroscope.scrape "anywherelan" {
  targets = [{
    __address__    = "host.docker.internal:8639",
    "service_name" = "anywherelan",
    "instance"     = "local",
  }]
  forward_to      = [pyroscope.write.local.receiver]
  scrape_interval = "60s"

  profiling_config {
    profile.process_cpu {
      enabled = true
      path    = "/api/v0/debug/pprof/profile"
      delta   = true
    }
    profile.memory {
      enabled = true
      path    = "/api/v0/debug/pprof/heap"
      delta   = false
    }
    profile.goroutine {
      enabled = true
      path    = "/api/v0/debug/pprof/goroutine"
      delta   = false
    }
    profile.mutex {
      enabled = false
    }
    profile.block {
      enabled = false
    }
  }
}

pyroscope.write "local" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
