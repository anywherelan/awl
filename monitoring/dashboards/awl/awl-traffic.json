          "editorMode": "code",
          "expr": "sum by (instance) (rate(awl_vpn_packets_dropped_total{instance=~\"$instance\",reason=~\"outbound_channel_full|gateway_channel_full|stream_error|peer_offline\"}[$__rate_interval])) / (sum by (instance) (rate(awl_vpn_packets_sent_total{instance=~\"$instance\"}[$__rate_interval])) + sum by (instance) (rate(awl_vpn_packets_dropped_total{instance=~\"$instance\",reason=~\"outbound_channel_full|gateway_channel_full|stream_error|peer_offline\"}[$__rate_interval])))",
