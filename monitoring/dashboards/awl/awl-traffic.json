{
  "uid": "awl-traffic",
  "title": "awl Traffic",
  "description": "libp2p traffic by protocol, VPN tunnel, SOCKS5 proxy, DNS and local API.",
  "tags": [
    "awl"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 38,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(awl_node_start_timestamp{instance=~\"$instance\"}[1m]) > 0",
        "step": "1m",
        "titleFormat": "awl restarted",
        "textFormat": "{{instance}}"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "awl"
      ],
      "title": "awl",
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(awl_node_uptime_seconds, instance)",
        "query": {
          "query": "label_values(awl_node_uptime_seconds, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "libp2p",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
