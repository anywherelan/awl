    {
      "type": "timeseries",
      "title": "Traffic by protocol, in",
      "description": "All libp2p traffic of the node, the tunnel included, stacked. unknown: before a stream agrees on a protocol.",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (instance, protocol) (rate(awl_p2p_bandwidth_bytes_total{instance=~\"$instance\",direction=\"in\"}[$__rate_interval]))*8",
          "legendFormat": "{{protocol}} {{instance}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
